{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness (Tauri)",
  "version": "0.2.2",
  "identifier": "com.qwq123321123.dsh-desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "resources": [
      "resources/node/dsh-node.exe",
      "resources/dsh-runtime/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
